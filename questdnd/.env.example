# ID вашей Google Таблицы (длинная строка из адресной строки браузера между /d/ и /edit)
GOOGLE_SHEET_ID=вставьте_сюда_ID_таблицы

# Имя файла ключа Google (скачайте из Google Cloud Console)
GOOGLE_CREDENTIALS_FILE=google_credentials.json

# ID облака Яндекс (Cloud ID), где включен YandexGPT (начинается на b1g...)
YANDEX_CLOUD_ID=вставьте_сюда_YANDEX_CLOUD_ID

# Folder ID (каталог), где будут крутиться модели (начинается на b1h...)
YANDEX_FOLDER_ID=вставьте_сюда_YANDEX_FOLDER_ID

# Имя файла ключа Яндекс Облака (сервисный аккаунт)
YANDEX_AUTH_FILE=authorized_key.json
